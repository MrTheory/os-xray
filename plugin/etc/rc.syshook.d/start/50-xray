#!/bin/sh

LOG="/var/log/xray-boot.log"
LOG_MAX=50000   # ~50 KB — soft rotate; newsyslog also rotates

# B11: ротация лога
if [ -f "$LOG" ]; then
    _size=$(wc -c < "$LOG" 2>/dev/null || echo 0)
    if [ "$_size" -gt "$LOG_MAX" ]; then
        mv -f "$LOG" "${LOG}.0"
    fi
fi

exec >> "$LOG" 2>&1
echo ""
echo "=== xray syshook start: $(date) ==="

XRAY_BIN="/usr/local/bin/xray-core"
T2S_BIN="/usr/local/tun2socks/tun2socks"

# v3.0.0: первый аргумент — inst_uuid конкретного инстанса (опционально)
# Если не задан — обрабатываем все инстансы из config.xml
# Второй аргумент "light" / boot flag: только TUN IP, без filter/interface/birdsync
INST_UUID="${1:-}"
LIGHT_ARG="${2:-}"

ENABLED=$(php -r 'set_include_path("/usr/local/etc/inc" . PATH_SEPARATOR . get_include_path()); require_once("config.inc"); $cfg = OPNsense\Core\Config::getInstance()->object(); echo (string)($cfg->OPNsense->xray->general->enabled ?? "0");' 2>/dev/null)

LIGHT_MODE=0
if [ "$LIGHT_ARG" = "light" ] || [ -f /var/run/xray_boot_light ] || [ -f /var/run/booting ]; then
    LIGHT_MODE=1
fi

echo "enabled=[$ENABLED] inst_uuid=[$INST_UUID] light=[$LIGHT_MODE]"

[ "$ENABLED" = "1" ] || { echo "xray disabled, exit"; exit 0; }
[ -f "$XRAY_BIN" ]   || { echo "xray-core not found"; exit 0; }
[ -f "$T2S_BIN" ]    || { echo "tun2socks not found"; exit 0; }

# Функция: настроить TUN для одного инстанса
setup_instance() {
    _INST_UUID="$1"

    # BUG-8 FIX: ожидаем per-instance lock
    _XRAY_LOCK="/var/run/xray_start_${_INST_UUID}.lock"
    _lock_tries=0
    while [ -f "$_XRAY_LOCK" ] && [ $_lock_tries -lt 10 ]; do
        echo "  [${_INST_UUID}] waiting for lock (${_lock_tries}s)..."
        sleep 1
        _lock_tries=$((_lock_tries+1))
    done

    # Read tun_interface and mtu in one PHP call;
    # Note: SimpleXML elements are never null, so ?? is dead code — use string check.
    _INST_INFO=$(_INST_UUID="$_INST_UUID" php -r '
        set_include_path("/usr/local/etc/inc" . PATH_SEPARATOR . get_include_path());
        require_once("config.inc");
        $cfg  = OPNsense\Core\Config::getInstance()->object();
        $uuid = getenv("_INST_UUID");
        foreach ($cfg->OPNsense->xray->instances->instance as $inst) {
            if ((string)$inst["uuid"] === $uuid) {
                $tun = (string)$inst->tun_interface;
                $mtu = (string)$inst->mtu;
                echo "TUN_IFACE=" . ($tun !== "" ? $tun : "proxytun2socks0") . "\n";
                echo "MTU="       . ($mtu !== "" ? $mtu : "1500")            . "\n";
                exit(0);
            }
        }
        echo "TUN_IFACE=proxytun2socks0\n";
        echo "MTU=1500\n";
    ' 2>>"$LOG")

    eval "$_INST_INFO"
    TUN_IFACE="${TUN_IFACE:-proxytun2socks0}"
    MTU="${MTU:-1500}"

    echo "[${_INST_UUID}] tun=[$TUN_IFACE] mtu=[$MTU]"

    # Ждём TUN интерфейс до 10 секунд
    echo "waiting for $TUN_IFACE..."
    i=0
    while [ $i -lt 10 ]; do
        ifconfig "$TUN_IFACE" > /dev/null 2>&1 && break
        sleep 1
        i=$((i+1))
        echo "  ${i}s..."
    done

    ifconfig "$TUN_IFACE" > /dev/null 2>&1 || { echo "[${_INST_UUID}] interface $TUN_IFACE not found after 10s!"; return 0; }

    # Поднимаем интерфейс и назначаем MTU
    ifconfig "$TUN_IFACE" mtu "$MTU" up 2>&1

    # IPv4 — по флагу инстанса; IPv6 — всегда из OPNsense, если задан на интерфейсе
    _TUN_ADDRS=$(_INST_UUID="$_INST_UUID" _TUN_IFACE="$TUN_IFACE" php -r '
        set_include_path("/usr/local/etc/inc" . PATH_SEPARATOR . get_include_path());
        require_once("config.inc");
        $cfg  = OPNsense\Core\Config::getInstance()->object();
        $uuid = getenv("_INST_UUID");
        $tun  = getenv("_TUN_IFACE");
        if (empty($tun)) $tun = "proxytun2socks0";

        $useIpv4 = true;
        foreach ($cfg->OPNsense->xray->instances->instance as $inst) {
            if ((string)$inst["uuid"] === $uuid) {
                $useIpv4 = (string)($inst->use_ipv4 ?? "1") === "1";
                break;
            }
        }
        echo "USE_IPV4=" . ($useIpv4 ? "1" : "0") . "\n";

        foreach ($cfg->interfaces->children() as $iface) {
            if ((string)$iface->if !== $tun) {
                continue;
            }
            $ipaddr = trim((string)$iface->ipaddr);
            $subnet = trim((string)$iface->subnet);
            if ($useIpv4 && $ipaddr !== "" && $subnet !== "") {
                echo "TUN_IP=" . $ipaddr . "/" . $subnet . "\n";
            }
            $ipaddrv6 = trim((string)$iface->ipaddrv6);
            $subnetv6 = trim((string)$iface->subnetv6);
            if ($ipaddrv6 !== "" && $subnetv6 !== "") {
                echo "TUN_IP6=" . $ipaddrv6 . "/" . $subnetv6 . "\n";
            }
            break;
        }
    ' 2>/dev/null)

    eval "$_TUN_ADDRS"
    TUN_IP="${TUN_IP:-}"
    TUN_IP6="${TUN_IP6:-}"
    USE_IPV4="${USE_IPV4:-1}"

    if [ "$USE_IPV4" = "1" ]; then
        if [ -n "$TUN_IP" ]; then
            echo "[${_INST_UUID}] assigning inet $TUN_IP to $TUN_IFACE..."
            ifconfig "$TUN_IFACE" inet "$TUN_IP" 2>&1
        else
            echo "[${_INST_UUID}] WARNING: IPv4 enabled but no IPv4 found in OPNsense interface config"
        fi
    else
        echo "[${_INST_UUID}] INFO: IPv4 routing disabled for instance, skipping IPv4 assignment"
    fi

    if [ -n "$TUN_IP6" ]; then
        echo "[${_INST_UUID}] assigning inet6 $TUN_IP6 to $TUN_IFACE..."
        ifconfig "$TUN_IFACE" inet6 "$TUN_IP6" 2>&1
    else
        echo "[${_INST_UUID}] INFO: no IPv6 configured on OPNsense interface, skipping IPv6 assignment"
    fi
}

if [ -n "$INST_UUID" ]; then
    # Обрабатываем конкретный инстанс
    setup_instance "$INST_UUID"
else
    # Обрабатываем все инстансы
    INST_UUIDS=$(php -r '
        set_include_path("/usr/local/etc/inc" . PATH_SEPARATOR . get_include_path());
        require_once("config.inc");
        $cfg = OPNsense\Core\Config::getInstance()->object();
        $instances = $cfg->OPNsense->xray->instances ?? null;
        if ($instances) {
            foreach ($instances->instance as $inst) {
                $uuid    = (string)$inst["uuid"];
                $enabled = (string)$inst->enabled;
                if ($uuid !== "" && $enabled === "1")
                    echo $uuid . "\n";
            }
        }
    ' 2>/dev/null)

    for uuid in $INST_UUIDS; do
        setup_instance "$uuid"
    done
fi

# Boot/light: TUN assignment only — filter/birdsync once via deferred birdsync_postboot.
# Normal: optional filter reload; never birdsync here (N parallel syshooks hung boot).
if [ "$LIGHT_MODE" = "1" ]; then
    echo "light mode: skip filter reload / interface reconfigure / birdsync"
else
    echo "reloading filter..."
    /usr/local/sbin/configctl filter reload 2>&1
    echo "birdsync: skipped here (use configctl xray birdsync / deferred postboot)"
fi

echo "=== done: $(date) ==="
exit 0
